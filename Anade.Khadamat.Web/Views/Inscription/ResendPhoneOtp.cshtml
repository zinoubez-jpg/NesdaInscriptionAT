@model Anade.Khadamat.Web.Models.ResendPhoneOtpVM
@{
    ViewData["Title"] = "إعادة إرسال رمز التحقق";
}

<div class="page-wrapper">
    <div class="about-section">
        <div class="auto-container">
            <div class="inner-container">
                <div class="row align-items-center clearfix">
                    <div class="container">
                        <partial name="_Message" />
                    </div>

                    <div class="content-column col-lg-10 col-md-12 col-sm-12 mb-0">
                        <div class="about-column">
                            <div class="sec-title">
                                <br />
                                <h2>إعادة إرسال <span>رمز SMS</span></h2>
                            </div>
                            <div class="text">
                                <p>
                                    أدخل رقم الهاتف المستخدم عند التسجيل. إذا كان الرقم مسجلاً وغير مفعّل بعد،
                                    سيتم إرسال رمز جديد عند انتهاء صلاحية الرمز السابق.
                                </p>
                            </div>

                            <form asp-action="ResendPhoneOtp" method="post" class="mt-4">
                                @Html.AntiForgeryToken()
                                <div class="form-group mb-3">
                                    <label asp-for="NumTelephone" class="form-label"></label>
                                    <input asp-for="NumTelephone" class="form-control" placeholder="0 5XX XX XX XX" />
                                    <span asp-validation-for="NumTelephone" class="text-danger"></span>
                                </div>
                                <button type="submit" class="theme-btn btn-style-one">إرسال</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
