@using Anade.Khadamat.Domain
@model Inscription
@{
    ViewData["Title"] = "Inscription réussie";
}


<div class="page-wrapper">



    <!-- About Section -->
    <div class="about-section">
        <div class="auto-container">
            <div class="inner-container">
                <div class="row align-items-center clearfix">

                    <div class="container">

                        <partial name="_Message" />
                    </div>
                    <!-- Image Column -->
                    <div class="image-column col-lg-4">
                        <div class="about-image">
                            <div class="about-inner-image">


                                <img src="~/TempletteCDE PF/images/success.png" />
                            </div>
                        </div>
                    </div>

                    <!-- Content Column -->
                    <div class="content-column col-lg-8 col-md-12 col-sm-12 mb-0">
                        <div class="about-column">
                            <div class="sec-title">
                                <div class="title"></div>
                                <br />
                                <br />
                                <h2> <span>شكرا!</span> لقد تم تسجيل طلبك بنجاح.  </h2>
                            </div>
                            <div class="text">
                                <p style="color: #7b241c; font-size:14px">سيتم إرسال رسالة تأكيد إلى عنوان البريد الإلكتروني الذي قدمته. يرجى النقر على الرابط المرفق لإتمام عملية التسجيل.</p>
                                <p style="color: #7b241c; font-size:14px">بعد تأكيد البريد الإلكتروني، ستتلقى رمز تحقق عبر SMS لتأكيد رقم هاتفك وإنشاء حسابك.</p>
                                <p class="mt-3">
                                    <a asp-controller="Inscription" asp-action="VerifyPhone" class="theme-btn btn-style-one"><span class="txt">صفحة التحقق من رقم الهاتف</span></a>
                                </p>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
    <!-- End About Section -->



</div>
