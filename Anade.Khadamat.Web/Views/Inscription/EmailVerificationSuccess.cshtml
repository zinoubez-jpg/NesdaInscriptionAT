@using Anade.Khadamat.Domain
@model Inscription
@{
    ViewData["Title"] = "تم التحقق من البريد الإلكتروني";
}

<div class="page-wrapper">
    <div class="about-section">
        <div class="auto-container">
            <div class="inner-container">
                <div class="row align-items-center clearfix">
                    <div class="image-column col-lg-4">
                        <div class="about-image">
                            <div class="about-inner-image">
                                <img src="~/TempletteCDE PF/images/SuccsesMailValidation.png" alt="Email verified" />
                            </div>
                        </div>
                    </div>

                    <div class="content-column col-lg-8 col-md-12 col-sm-12 mb-0">
                        <div class="about-column">
                            <div class="sec-title">
                                <br />
                                <h2>تم التحقق من صحة البريد الإلكتروني <span>بنجاح</span>.</h2>
                            </div>
                            <div class="text">
                                <p>
                                    الخطوة التالية: التحقق من رقم هاتفك عبر رمز SMS.
                                    بعد تأكيد الهاتف سيتم إنشاء حسابك تلقائياً.
                                </p>
                               @*  <p style="color:#7b241c;font-size:14px">
                                    إذا غادرت الصفحة أو لم يصلك الرمز، يمكنك العودة لاحقاً وإدخال رقم هاتفك المسجّل لإتمام التحقق.
                                </p> *@
                            </div>
                            <div class="btn-box mt-4">
                                <a asp-controller="Inscription" asp-action="VerifyPhone" class="theme-btn btn-style-one">
                                    <span class="txt">التحقق من رقم الهاتف الآن</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
