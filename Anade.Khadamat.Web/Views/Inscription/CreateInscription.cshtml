    <script>
        $(document).ready(function () {
            // Appliquer un masque au champ de numéro de téléphone
            $('#NumTelephone').inputmask({
                mask: "0 9 99 99 99 99", // Le masque pour afficher 0x xx xx xx
                placeholder: "0 _ __ __ __ __", // Affiche un espace réservé
                showMaskOnHover: false, // Ne montre pas le masque lorsque l'utilisateur survole
                showMaskOnFocus: true // Montre le masque uniquement lorsque le champ est actif
            });
        });
    </script>

    <script>
        document.getElementById('NumTelephone').addEventListener('input', function (e) {
            let value = e.target.value.replace(/\s+/g, ''); // Supprimer les espaces existants
            if (value.length > 10) value = value.slice(0, 10); // Limiter à 10 chiffres
            let formattedValue = '';

            // Appliquer le format
            for (let i = 0; i < value.length; i++) {
                if (i === 1 || i === 3 || i === 5 || i === 7) {
                    formattedValue += ' ';
                }
                formattedValue += value[i];
            }
            e.target.value = formattedValue; // Mettre à jour l'affichage
        });




    </script>

