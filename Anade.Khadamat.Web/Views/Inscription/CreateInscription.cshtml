    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.8/jquery.inputmask.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            setupFileInput("fileInput", "loadingState");
            setupFileInput("fileInput2", "loadingState2");
            setupFileInput("fileInput3", "loadingState3", false); // false = non obligatoire

            function setupFileInput(fileInputId, loadingStateId, isRequired = true) {
                const fileInput = document.getElementById(fileInputId);
                const loadingState = document.getElementById(loadingStateId);

                fileInput.addEventListener("change", function () {
                    loadingState.style.display = "none";

                    if (fileInput.files && fileInput.files.length > 0) {
                        const isValid = validatePDF(fileInput);
                        if (!isValid) {
                            return;
                        }

                        loadingState.style.display = "block";
                        loadingState.style.color = "#000";
                        loadingState.textContent = "جارٍ تحميل الملف...";

                        setTimeout(() => {
                            loadingState.textContent = "تم تحميل الملف بنجاح: " + fileInput.files[0].name;
                            loadingState.style.color = "#2c724f";
                        }, 1000);
                    } else if (isRequired) {
                        // Seulement afficher un message d'erreur si le champ est obligatoire
                        loadingState.style.display = "block";
                        loadingState.style.color = "#dc3545";
                        loadingState.textContent = "الرجاء تحميل الملف";
                    }
                });

                // Validation initiale pour les champs obligatoires
                if (isRequired) {
                    fileInput.addEventListener("blur", function () {
                        if (!fileInput.files || fileInput.files.length === 0) {
                            loadingState.style.display = "block";
                            loadingState.style.color = "#dc3545";
                            loadingState.textContent = "الرجاء تحميل الملف";
                        }
                    });
                }
            }

            function validatePDF(input) {
                const file = input.files[0];
                const maxSize = 2 * 1024 * 1024;

                if (file) {
                    if (file.type !== 'application/pdf') {
                        Swal.fire({
                            icon: 'error',
                            title: 'ملف غير صالح',
                            text: 'PDF الرجاء تحميل ملف بصيغة  .',
                            confirmButtonText: 'حسنًا'
                        }).then(() => {
                            input.value = "";
                        });
                        return false;
                    }

                    if (file.size > maxSize) {
                        Swal.fire({
                            icon: 'error',
                            title: 'حجم الملف كبير',
                            text: 'الرجاء تحميل ملف لا يتجاوز حجمه 2 ميغابايت.',
                            confirmButtonText: 'حسنًا'
                        }).then(() => {
                            input.value = "";
                        });
                        return false;
                    }
                }

                return true;
            }
        });
    </script>

    <script type="text/javascript">

        $(document).ready(function () {
            $("#designationCDE").prop("disabled", true);

            function checkAndLoadCentres() {
                var wilayaId = $("#wilayaCDE").val();
                var typeId = $("#TypeCDE").val();

                if (wilayaId && typeId) {
                    loadCentres(wilayaId, typeId);
                } else {
                    $("#designationCDE").html("<option value=''>إختيار مركز تطوير المقاولاتية</option>")
                        .prop("disabled", true);
                }
            }

            function loadCentres(wilayaId, typeId) {
                $.getJSON("/Inscription/GetCentreDeveloppementEntrepreneuriatList", {
                    WilayaId: wilayaId,
                    TypeCDEId: typeId
                }, function (data) {
                    var options = "<option value=''>إختيار مركز تطوير المقاولاتية</option>";
                    $.each(data, function (i, item) {
                        options += '<option value="' + item.value + '">' + item.text + '</option>';
                    });
                    $("#designationCDE").html(options).prop("disabled", false);
                });
            }
            // Écouter les changements sur les deux dropdowns
            $("#wilayaCDE").change(checkAndLoadCentres);
            $("#TypeCDE").change(checkAndLoadCentres);
        });

