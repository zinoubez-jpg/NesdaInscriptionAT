                var url = "/Inscription/GetCommuneList";

                if (wilayaNId) {
                    $.getJSON(url, { WilayaId: wilayaNId }, function (data) {
                        var item = "<option value=''>إختيار بلدية الميلاد</option>";
                        $.each(data, function (i, city) {
