    <script>
        const input = document.getElementById('NIN');

        input.addEventListener('input', () => {
            const regex = /[0-9]/;
            const value = input.value;

            for (let i = 0; i < value.length; i++) {
                if (!regex.test(value[i])) {
                    input.value = value.substring(0, i);
                    break;
                }
            }
        });



    </script>
    <script type="text/javascript">

        function restrictInputOtherThanArabic($field) {
            // Plage de caractères Unicode pour les caractères arabes, chiffres arabes, et chiffres occidentaux
            var arabicCharUnicodeRange = /^[\u0600-\u06FF\u0660-\u0669\u0030-\u0039\s]+$/; // Ajout des chiffres occidentaux et des espaces

            // Événement keypress pour empêcher les saisies autres que les caractères arabes et chiffres
            $field.on("keypress", function (event) {
                var key = event.which;
                // Autoriser retour arrière (backspace), pavé numérique (0), et espace (32)
                if (key == 8 || key == 0 || key === 32) {
                    return true;
                }

                var str = String.fromCharCode(key);
                if (arabicCharUnicodeRange.test(str)) {
                    return true;
                }

                return false;
            });

            // Empêche coller (paste) si le texte contient des caractères autres qu'arabes ou chiffres
            $field.on("paste", function (event) {
                var clipboardData = (event.originalEvent || event).clipboardData || window.clipboardData;
                var pastedData = clipboardData.getData('text'); // Récupère les données collées

                // Bloque l'événement si le texte collé contient des caractères non autorisés
                if (!arabicCharUnicodeRange.test(pastedData)) {
                    event.preventDefault(); // Empêche le coller si du texte non autorisé est détecté
                }
            });

            // Empêche déposer du texte (drag and drop) si non autorisé
            $field.on("drop", function (event) {
                var draggedData = event.originalEvent.dataTransfer.getData('text');

                // Bloque le drop si le texte contient des caractères non autorisés
                if (!arabicCharUnicodeRange.test(draggedData)) {
                    event.preventDefault();
                }
            });
        }

        jQuery(document).ready(function () {
            // Appliquer la restriction aux champs
            restrictInputOtherThanArabic($('#AdresseDomicileAr'));
            restrictInputOtherThanArabic($('#AdresseSiegeAr'));
        });


        jQuery(document).ready(function () {
            // allow arabic characters only for following fields
            restrictInputOtherThanArabic($('#NomAr'));
            restrictInputOtherThanArabic($('#PrenomAr'));
            restrictInputOtherThanArabic($('#AdressAr'));
           
        });
    </script>
