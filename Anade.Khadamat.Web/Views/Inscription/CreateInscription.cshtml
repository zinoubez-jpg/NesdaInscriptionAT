                                    @if (ViewBag.TypeInsId == 2)
                                    {
                                        <p style="text-align: justify;">
                                            هذه الاستمارة مخصصة للتسجيل عبر الإنترنت لطلب التمويل لإنشاء مشروع توسيعي في إطار جهاز الوكالة الوطنية لدعم وتنمية المقاولاتية.
                                        </p>
                                    }
                                    else
