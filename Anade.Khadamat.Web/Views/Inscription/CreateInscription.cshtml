    <script>
        $(document).ready(function () {
            // Appliquer un masque au champ de numéro de téléphone
            $('#NumTelephone').inputmask({
                mask: "0 9 99 99 99 99", // Le masque pour afficher 0x xx xx xx
                placeholder: "0 _ __ __ __ __", // Affiche un espace réservé
                showMaskOnHover: false, // Ne montre pas le masque lorsque l'utilisateur survole
                showMaskOnFocus: true // Montre le masque uniquement lorsque le champ est actif
            });
        });

    </script>

    <script>
        document.getElementById('NumTelephone').addEventListener('input', function (e) {
            let value = e.target.value.replace(/\s+/g, ''); // Supprimer les espaces existants
            if (value.length > 10) value = value.slice(0, 10); // Limiter à 10 chiffres
            let formattedValue = '';

            // Appliquer le format
            for (let i = 0; i < value.length; i++) {
                if (i === 1 || i === 3 || i === 5 || i === 7) {
                    formattedValue += ' ';
                }
                formattedValue += value[i];
            }

            e.target.value = formattedValue; // Mettre à jour l'affichage
        });




    </script>


    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Cibler la checkbox et le div
            const checkbox = document.getElementById('customCheckbox');
            const contratDiv = document.getElementById('contrat');
            const inputs = document.querySelectorAll('.required-input'); // Sélectionner les inputs à vérifier

            if (checkbox && contratDiv) {
                // Ajouter un gestionnaire d'événement pour la checkbox
                checkbox.addEventListener('change', function () {
                    if (checkbox.checked) {
                        // Si la checkbox est cochée, activer le div
                        contratDiv.classList.remove('disabled');
                    } else {
                        // Sinon, désactiver le div
                        contratDiv.classList.add('disabled');
                    }
                });

                // Vérifier les inputs lors du chargement de la page
                let inputFilled = Array.from(inputs).some(input => input.value.trim() !== '');
                if (inputFilled) {
                    checkbox.checked = true;
                    contratDiv.classList.remove('disabled');
                }

                // Surveiller les changements dans les inputs pour activer uniquement le div
                inputs.forEach(input => {
                    input.addEventListener('input', function () {
                        let inputFilled = Array.from(inputs).some(input => input.value.trim() !== '');
                        if (inputFilled) {
                            contratDiv.classList.remove('disabled');
                        }
                    });
                });
            } else {
                console.error('Checkbox ou div non trouvé.');
            }

            document.addEventListener('click', function (event) {
                const checkbox = document.querySelector('#customCheckbox'); // Sélectionner la checkbox par son ID
                const label = document.querySelector('.custom-checkbox'); // Sélectionner le conteneur du label

                if (checkbox) {
                    // Vérifier si la checkbox est décochée et que le clic n'est pas sur la checkbox
                    if (!checkbox.checked && event.target !== checkbox) {
                        // Ajouter une classe d'erreur à la checkbox
                        checkbox.classList.add('error');
                        // Changer la couleur du texte du label en rouge
                        label.style.color = 'red';

                        // Défilement fluide en haut de la page
                        window.scrollTo({
                            top: 0,
                            behavior: 'smooth'
                        });
                    } else {
                        // Réinitialiser les styles si la checkbox est cochée
                        checkbox.classList.remove('error');
                        label.style.color = ''; // Réinitialiser la couleur par défaut
                    }
                }
            });


        });


    </script>

   

    <script>
        document.addEventListener("DOMContentLoaded", function () {
