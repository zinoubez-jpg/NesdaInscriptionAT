    <script>

        //$(document).ready(function () {
        //    // Appliquer un masque au champ de numéro de téléphone
        //    $('#NumTelephone').inputmask({
        //        mask: "0 9 99 99 99 99", // Le masque pour afficher 0x xx xx xx
        //        placeholder: "0 _ __ __ __ __", // Affiche un espace réservé
        //        showMaskOnHover: false, // Ne montre pas le masque lorsque l'utilisateur survole
        //        showMaskOnFocus: true // Montre le masque uniquement lorsque le champ est actif
        //    });
        //});

        document.addEventListener('DOMContentLoaded', function () {
            const phoneInput = document.getElementById('NumTelephone');

            // Supprimer tout attribut inputmask existant
            phoneInput.removeAttribute('data-inputmask');

            // Formater le numéro pendant la saisie
            phoneInput.addEventListener('input', function (e) {
                // Garder uniquement les chiffres
                let rawValue = e.target.value.replace(/\D/g, '');

                // Limiter à 10 chiffres (format algérien: 0xxxxxxxxx)
                if (rawValue.length > 10) {
                    rawValue = rawValue.substring(0, 10);
                }

                // Formater avec des espaces
                let formattedValue = formatPhoneNumber(rawValue);

                // Mettre à jour la valeur
                e.target.value = formattedValue;

                // Gérer le curseur
                const cursorPosition = e.target.selectionStart;
                const diff = formattedValue.length - e.target.value.length;

                if (diff !== 0 && cursorPosition) {
                    e.target.setSelectionRange(cursorPosition + diff, cursorPosition + diff);
                }
            });

            // Fonction de formatage
            function formatPhoneNumber(numbers) {
                if (!numbers) return '';

                let formatted = '';

                // Ajouter le 0 initial si nécessaire
                if (numbers.length > 0 && numbers[0] !== '0') {
                    numbers = '0' + numbers;
                    if (numbers.length > 10) numbers = numbers.substring(0, 10);
                }

                // Appliquer le format: 0 XXX XXX XXX

                //for (let i = 0; i < numbers.length; i++) {
                //    if (i === 1 || i === 4 || i === 7) {
                //        formatted += ' ';
                //    }
                //    formatted += numbers[i];
                //}

                // Appliquer le format: 0 XXX XX XX XX

                for (let i = 0; i < numbers.length; i++) {
                    if (i === 1 || i === 4 || i === 6 || i === 8) {
                        formatted += ' ';
                    }
                    formatted += numbers[i];
                }

                return formatted.trim();
            }

            // Gestion du focus pour améliorer l'expérience mobile
            phoneInput.addEventListener('focus', function () {
                // Si le champ est vide, ajouter le 0 initial
                if (!this.value || this.value.trim() === '') {
                    this.value = '0 ';
                    this.setSelectionRange(2, 2); // Placer le curseur après "0 "
                }
            });

            // Gestion du collage (paste)
            phoneInput.addEventListener('paste', function (e) {
                // Attendre que le contenu soit collé
                setTimeout(() => {
                    let rawValue = this.value.replace(/\D/g, '');

                    if (rawValue.length > 10) {
                        rawValue = rawValue.substring(0, 10);
                    }

                    this.value = formatPhoneNumber(rawValue);
                }, 10);
            });

            // Forcer le clavier numérique sur mobile
            phoneInput.setAttribute('inputmode', 'numeric');
            phoneInput.setAttribute('pattern', '[0-9 ]*');
        });

    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            setupFileInput("fileInput", "loadingState");
            setupFileInput("fileInput2", "loadingState2");
            setupFileInput("fileInput3", "loadingState3", false); // false = non obligatoire

            function setupFileInput(fileInputId, loadingStateId, isRequired = true) {
                const fileInput = document.getElementById(fileInputId);
                const loadingState = document.getElementById(loadingStateId);

                fileInput.addEventListener("change", function () {
                    loadingState.style.display = "none";

                    if (fileInput.files && fileInput.files.length > 0) {
                        const isValid = validatePDF(fileInput);
                        if (!isValid) {
                            return;
                        }

                        loadingState.style.display = "block";
                        loadingState.style.color = "#000";
                        loadingState.textContent = "جارٍ تحميل الملف...";

                        setTimeout(() => {
                            loadingState.textContent = "تم تحميل الملف بنجاح: " + fileInput.files[0].name;
                            loadingState.style.color = "#2c724f";
                        }, 1000);
                    } else if (isRequired) {
                        // Seulement afficher un message d'erreur si le champ est obligatoire
                        loadingState.style.display = "block";
                        loadingState.style.color = "#dc3545";
                        loadingState.textContent = "الرجاء تحميل الملف";
                    }
                });

                // Validation initiale pour les champs obligatoires
                if (isRequired) {
                    fileInput.addEventListener("blur", function () {
                        if (!fileInput.files || fileInput.files.length === 0) {
                            loadingState.style.display = "block";
                            loadingState.style.color = "#dc3545";
                            loadingState.textContent = "الرجاء تحميل الملف";
                        }
                    });
                }
            }

            function validatePDF(input) {
                const file = input.files[0];
                const maxSize = 2 * 1024 * 1024;

                if (file) {
                    if (file.type !== 'application/pdf') {
                        Swal.fire({
                            icon: 'error',
                            title: 'ملف غير صالح',
                            text: 'PDF الرجاء تحميل ملف بصيغة  .',
                            confirmButtonText: 'حسنًا'
                        }).then(() => {
                            input.value = "";
                        });
                        return false;
                    }

                    if (file.size > maxSize) {
                        Swal.fire({
                            icon: 'error',
                            title: 'حجم الملف كبير',
                            text: 'الرجاء تحميل ملف لا يتجاوز حجمه 2 ميغابايت.',
                            confirmButtonText: 'حسنًا'
                        }).then(() => {
                            input.value = "";
                        });
                        return false;
                    }
                }

                return true;
            }
        });
    </script>

