@model Anade.Khadamat.Web.Models.VerifyPhoneOtpVM
@{
    ViewData["Title"] = "التحقق من رقم الهاتف";
}

<div class="page-wrapper">
    <div class="about-section">
        <div class="auto-container">
            <div class="inner-container">
                <div class="row align-items-center clearfix">
                    <div class="container">
                        <partial name="_Message" />
                        @if (ViewData["Message"] != null)
                        {
                            @Html.Raw(ViewData["Message"])
                        }
                    </div>

                    <div class="image-column col-lg-4">
                        <div class="about-image">
                            <div class="about-inner-image">
                                <img src="~/TempletteCDE PF/images/success.png" alt="OTP" />
                            </div>
                        </div>
                    </div>

                    <div class="content-column col-lg-8 col-md-12 col-sm-12 mb-0">
                        <div class="about-column">
                            <div class="sec-title">
                                <br />
                                <h2>التحقق من <span>رقم الهاتف</span></h2>
                            </div>
                            <div class="text">
                                <p>
                                    تم إرسال رمز التحقق عبر رسالة قصيرة إلى الرقم
                                    <strong>@Model.MaskedPhone</strong>.
                                    الرمز صالح لمدة <strong>@Model.ValidityMinutes</strong> دقيقة.
                                </p>
                                <p style="color:#7b241c;font-size:14px">
                                    يرجى أيضاً التحقق من بريدك الإلكتروني لتفعيل الحساب عبر الرابط المرسل.
                                </p>
                            </div>

                            <form asp-action="VerifyPhone" method="post" class="mt-4">
                                @Html.AntiForgeryToken()
                                <input type="hidden" asp-for="InscriptionId" />
                                <input type="hidden" asp-for="MaskedPhone" />
                                <input type="hidden" asp-for="ValidityMinutes" />

                                <div class="form-group mb-3">
                                    <label asp-for="OtpCode" class="form-label"></label>
                                    <input asp-for="OtpCode" class="form-control" autocomplete="one-time-code" inputmode="numeric" maxlength="10" placeholder="******" />
                                    <span asp-validation-for="OtpCode" class="text-danger"></span>
                                </div>

                                <button type="submit" class="theme-btn btn-style-one">تأكيد الرمز</button>
                            </form>

                            <p class="mt-4">
                                لم يصلك الرمز؟
                                <a asp-action="ResendPhoneOtp">إعادة إرسال رمز SMS</a>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
