@using Anade.Khadamat.Domain
@using System.Linq
@model Anade.Khadamat.Domain.Inscription
@{ Layout = "_LayoutEspacePromoteur"; }

<style>
    .equal-height {
        display: flex;
        flex-wrap: wrap; /* Important for responsiveness */
    }

        .equal-height > .col-xl-4,
        .equal-height > .col-xl-8 { /* Target the columns directly */
            display: flex;
            flex-direction: column; /* Align content vertically */
        }

            .equal-height > .col-xl-4 > .card,
            .equal-height > .col-xl-8 > .card { /* Target the cards within the columns */
                flex: 1 1 auto; /* Key: Allows cards to grow and fill available space */
            }
</style>

<br />
<br />
<div class="container-fluid">
    <div class="edit-profile">

        @* ✅ Messages de succès / erreur *@
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class="fa fa-check-circle"></i> @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class="fa fa-exclamation-triangle"></i> @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <div class="row equal-height">
            <div class="col-xl-4">
                <div class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">معلومات صاحب المشروع</h4>
                        <div class="card-options"><a class="card-options-collapse" href="#" data-bs-toggle="card-collapse"><i class="fe fe-chevron-up"></i></a><a class="card-options-remove" href="#" data-bs-toggle="card-remove"><i class="fe fe-x"></i></a></div>
                    </div>
                    <div class="card-body">

                        <div class="row mb-2">
                            <div class="profile-title">
                                <div class="media">
                                    <img class="img-70 rounded-circle" alt="" src="~/images/profile2.png">
                                    <div class="media-body">
                                        <h5 class="mb-1"> @Model.NomAr  @Model.PrenomAr </h5>
                                        <p>@Model.NomFr  @Model.PrenomFr</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">الرقم التعريفي الوطني الوحيد</label>
                            <input class="form-control" readonly placeholder="@Model.NIN">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">تاريخ الميلاد</label>
                            <input class="form-control" readonly placeholder="@Model.DateNaissance.ToShortDateString()">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">مكان الميلاد</label>
                            <input class="form-control" readonly placeholder="@Model.CommuneNaissance.DesignationAr / @Model.CommuneNaissance.Wilaya.DesignationAr">
                        </div>

                        <div class="mb-3">
                            <label class="form-label">العنوان الشخصي</label>
                            <input class="form-control" readonly placeholder="@Model.AdressAr / @Model.CommuneResidence.DesignationAr / @Model.CommuneResidence.Wilaya.DesignationAr">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">رقم الهاثف المحمول</label>
                            <input class="form-control" style="direction: ltr; text-align: right;" readonly placeholder="@Model.NumTelephone">
                        </div>
                        <div class="mb-3">
                            <label class="form-label">البريد الإلكتروني</label>
                            <input class="form-control" readonly placeholder="@Model.Email">
                        </div>

                    </div>
                </div>
            </div>


            <div class="col-xl-8">
                <form class="card">
                    <div class="card-header">
                        <h4 class="card-title mb-0">معلومات التسجيل</h4>
                        <div class="card-options"><a class="card-options-collapse" href="#" data-bs-toggle="card-collapse"><i class="fe fe-chevron-up"></i></a><a class="card-options-remove" href="#" data-bs-toggle="card-remove"><i class="fe fe-x"></i></a></div>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-5">
                                <div class="mb-3">
                                    <label class="form-label">رقم التسجيل</label>
                                    <input class="form-control" readonly placeholder="@Model.Id">
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="mb-3">
                                    <label class="form-label">تاريخ التسجيل</label>
                                    <input class="form-control" type="text" readonly placeholder="@Model.DateInscription.ToShortDateString()">
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-4">
                                <div class="mb-3">
                                    <label class="form-label">نوع التسجيل</label>
                                    <input class="form-control" type="text" readonly placeholder="@Model.TypeInscription.DesignationAr">
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-5">
                                <div class="mb-3">
                                    <label class="form-label">نوع التمويل</label>
                                    <input class="form-control" type="text" readonly placeholder="@Model.TypeFinancement.DesignationAr">
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-7">
                                <div class="mb-3">
                                    <label class="form-label">نوع الفئة</label>
                                    <input class="form-control" type="text" readonly placeholder="@Model.Categorie.DesignationAr">
                                </div>
                            </div>

                            <div class="col-md-12">
                                <div class="mb-3">
                                    <label class="form-label">نوع النشاط</label>
                                    <input class="form-control" type="text" readonly placeholder="@Model.Activite.DesignationAr">
                                </div>
                            </div>

                        </div>
                    </div>

                </form>

                <div class="card">
                    <div class="card-header">
                        <h4>معلومات المقر الإجتماعي</h4>
                    </div>
                    <div class="card-body">
                        <div class="row">

                            @if (!Model.Validee)
                            {
                                <form asp-controller="EspacePromoteur" asp-action="UpdateSiegeSocial" method="post" id="formSiegeSocial">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="Id" value="@Model.Id" />

                                    <div class="row">
                                        <div class="col-md-5">
                                            <label class="form-label">عنوان المقر الإجتماعي</label>
                                            <input class="form-control" name="AddresseArSeigeSocial"
                                                   value="@Model.AddresseArSeigeSocial" />
                                        </div>

                                        <div class="col-sm-6 col-md-4">
                                            <label asp-for="WilayaSeigeSocialId">الولاية<span style="color:red;">*</span></label>
                                            <select asp-for="WilayaSeigeSocialId" asp-items="@ViewBag.WilayaSeigeSocialId as SelectList" class="form-control select2" id="wilayaSS" required>
                                                <option value="">إختيار الولاية </option>
                                            </select>
                                            <span asp-validation-for="WilayaSeigeSocialId" class="text-danger"></span>
                                        </div>

                                        <div class="col-sm-6 col-md-3">
                                            <label asp-for="CommuneSeigeSocialId">البلدية<span style="color:red;">*</span> </label>
                                            <select asp-for="CommuneSeigeSocialId"
                                                    asp-items="@ViewBag.CommuneSeigeSocialId as SelectList"
                                                    class="form-control select2"
                                                    id="communeSS" required>
                                                <option value="">إختيار البلدية</option>
                                            </select>
                                            <span asp-validation-for="CommuneSeigeSocialId" class="text-danger"></span>
                                        </div>

                                        <div class="card-header">
                                            <h4 style="color: #C70039;">ملاحظة هامة</h4>
                                        </div>

                                        <div class="col-sm-6 col-md-8">
                                            <div class="mb-3">
                                                <p style="color: #006666; margin-right: 20px">يمكنك تعديل بيانات المقر الإجتماعي من أجل تغيير الفرع المحلي الذي تم تحويل ملفك إليه.</p>
                                            </div>
                                        </div>

                                        <div class="col-sm-6 col-md-4">
                                            <div class="mb-3">
                                                <button type="submit" class="btn btn-primary" id="btnSubmitSiegeSocial">
                                                    <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true" id="spinnerSiegeSocial"></span>
                                                    <span id="textBtnSiegeSocial">إرسال</span>
                                                </button>
                                            </div>
                                        </div>

                                    </div>
                                </form>
                            }
                            else
                            {
                                <div class="col-md-5">
                                    <div class="mb-3">
                                        <label class="form-label">عنوان المقر الإجتماعي</label>
                                        <input class="form-control" readonly placeholder="@Model.AddresseArSeigeSocial">
                                    </div>
                                </div>
                                <div class="col-sm-6 col-md-3">
                                    <div class="mb-3">
                                        <label class="form-label">البلدية</label>
                                        <input class="form-control" type="text" readonly placeholder="@Model.CommuneSiegeSocial.DesignationAr">
                                    </div>
                                </div>
                                <div class="col-sm-6 col-md-4">
                                    <div class="mb-3">
                                        <label class="form-label">الولاية</label>
                                        <input class="form-control" type="text" readonly placeholder="@Model.CommuneSiegeSocial.Wilaya.DesignationAr">
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h4>قائمة التكوينات التي تم المشاركة فيها</h4>
                    </div>
                    @if (!Model.SessionFormations.Any())
                    {
                        <p style="color: #C70039; margin-right:20px">لم تشارك في أي دورة تكوينية حتى الآن.</p> }
                    else
                    {
                        <div class="table-responsive signal-table custom-scrollbar">
                            <table class="table table-hover">
                                <thead>
                                    <tr>

                                        <th scope="col">رقم الدورة</th>
                                        <th scope="col">إسم الدورة التدريبية	</th>
                                        <th scope="col">تاريخ البداية</th>
                                        <th scope="col">تاريخ نهاية الدورة</th>
                                        <th></th>

                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.SessionFormations)
                                    {
                                        <tr>
                                            <td>@item.CodeSession</td>
                                            <td>@item.Formation.DesignationAr</td>
                                            <td>@item.DateDebut.ToShortDateString()</td>
                                            <td>@item.DateFin.ToShortDateString()</td>
                                            <td>
                                                <a asp-controller="Reporting" asp-action="PrintAtF" asp-route-Id="@Model.Id" asp-route-SessionId="@item.Id" class="btn btn-outline-primary btn-sm" title="تحميل الشهادة">
                                                    تحميل الشهادة
                                                </a>
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts{
    <script>
        $(document).ready(function () {
            $("#communeSS").prop("disabled", false);
            $("#wilayaSS").change(function () {
                var wilayaSSId = $(this).val();
                var url = "/Inscription/GetCommuneList";

                if (wilayaSSId) {
                    $.getJSON(url, { WilayaId: wilayaSSId }, function (data) {
                        var item = "<option value=''>إختيار بلدية الإقامة</option>";
                        $.each(data, function (i, city) {
                            item += '<option value="' + city.value + '">' + city.text + '</option>'
                        });
                        $("#communeSS").html(item).prop("disabled", false);
                    });
                } else {
                    $("#communeSS").html("<option value=''>إختيار بلدية الإقامة</option>").prop("disabled", true);
                }
            });

            // ✅ Gestion du bouton submit pour le formulaire SiegeSocial
            $("#formSiegeSocial").on("submit", function (e) {
                var $form = $(this);

                // Vérification de la validation côté client (si activée)
                if ($form.data("valid") === false) {
                    return false;
                }

                // Désactiver le bouton et afficher le spinner
                var $btn = $("#btnSubmitSiegeSocial");
                $btn.prop("disabled", true);
                $("#spinnerSiegeSocial").removeClass("d-none");
                $("#textBtnSiegeSocial").text("جاري الإرسال...");

                // Réactiver le bouton après un certain temps (en cas de problème)
                // ou compter sur la réponse du serveur pour recharger la page
                setTimeout(function () {
                    // Sécurité : réactiver après 30 secondes max
                    if ($btn.prop("disabled")) {
                        $btn.prop("disabled", false);
                        $("#spinnerSiegeSocial").addClass("d-none");
                        $("#textBtnSiegeSocial").text("إرسال");
                    }
                }, 30000);
            });

        });
    </script>
}