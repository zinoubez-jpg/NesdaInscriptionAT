<!DOCTYPE html>
<html lang="en" dir="rtl">

<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="author" content="pixelstrap">
    <link rel="icon" href="assets/images/favicon.png" type="image/x-icon">
    <link rel="shortcut icon" href="assets/images/favicon.png" type="image/x-icon">
    <title>Espace Promoteur - NESDA</title>

    <!-- Google font-->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@200;300;400;500;600;700;800&amp;display=swap" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/font-awesome.css">
    <!-- ico-font-->
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/vendors/icofont.css">
    <!-- Themify icon-->
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/vendors/themify.css">
    <!-- Flag icon-->
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/vendors/flag-icon.css">
    <!-- Feather icon-->
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/vendors/feather-icon.css">
    <!-- Plugins css start-->
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/vendors/slick.css">
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/vendors/slick-theme.css">
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/vendors/scrollbar.css">
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/vendors/animate.css">
    <!-- Plugins css Ends-->
    <!-- Bootstrap css-->
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/vendors/bootstrap.css">
    <!-- App css-->
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/style.css">
    <link id="color" rel="stylesheet" href="~/AccountTemplette/assets/css/color-1.css" media="screen">
    <!-- Responsive css-->
    <link rel="stylesheet" type="text/css" href="~/AccountTemplette/assets/css/responsive.css">
    <link href="https://fonts.googleapis.com/css2?family=Noto+Kufi+Arabic&display=swap" rel="stylesheet">

    @RenderSection("head", false)

</head>


<body class="rtl" style="font-family:'Noto Kufi Arabic';">
    <!-- tap on top starts-->
    <div class="tap-top"><i data-feather="chevrons-up"></i></div>
    <!-- tap on tap ends-->
    <!-- page-wrapper Start-->
    <div class="page-wrapper compact-wrapper" id="pageWrapper">
        <!-- Page Header Start-->
        <div class="page-header">
            <div class="header-wrapper row m-0">

                <div class="header-logo-wrapper col-auto p-0">
                    <div class="logo-wrapper"> <a asp-controller="home" asp-action="Index"><img class="img-fluid for-light" src="~/AccountTemplette/assets/images/logo/logo_dark.png" alt="logo-light"><img class="img-fluid for-dark" src="~/AccountTemplette/assets/images/logo/logo.png" alt="logo-dark"></a></div>
                    <div class="toggle-sidebar"> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-align-center status_toggle middle sidebar-toggle"><line x1="18" y1="10" x2="6" y2="10"></line><line x1="21" y1="6" x2="3" y2="6"></line><line x1="21" y1="14" x2="3" y2="14"></line><line x1="18" y1="18" x2="6" y2="18"></line></svg></div>
                </div>
                <div class="left-header col-xxl-5 col-xl-6 col-lg-5 col-md-4 col-sm-3 p-0">
                    <div>
                        <a class="toggle-sidebar" href="#"> <i class="iconly-Category icli"> </i></a>
                        <div class="d-flex align-items-center gap-2 ">
                            <h4 class="f-w-600">مرحبا بك</h4><img class="mt-0" src="~/AccountTemplette/assets/images/hand.gif" alt="hand-gif">
                        </div>
                    </div>
                    <div class="welcome-content d-xl-block d-none"><span class="text-truncate col-12">في البوابة الرقمية لوكالة الوطنية لدعم وتنمية المقاولاتية (NESDA) </span></div>
                </div>
                <div class="nav-right col-xxl-7 col-xl-6 col-md-7 col-8 pull-right right-header p-0 ms-auto">
                    <partial name="_LoginPartial2" />
                </div>
                <script class="result-template" type="text/x-handlebars-template">
                    <div class="ProfileCard u-cf">
                        <div class="ProfileCard-avatar"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-airplay m-0"><path d="M5 17H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-1"></path><polygon points="12 15 17 21 7 21 12 15"></polygon></svg></div>
                        <div class="ProfileCard-details">
                            <div class="ProfileCard-realName">{{name}}</div>
                        </div>
                    </div>
                </script>

            </div>
        </div>
        <!-- Page Header Ends                              -->
        <!-- Page Body Start-->
        <div class="page-body-wrapper">
            <!-- Page Sidebar Start-->
            <div class="sidebar-wrapper" data-layout="stroke-svg">
                <div class="logo-wrapper">
                    <a asp-controller="Home" asp-action="Index"><img class="img-fluid" src="~/AccountTemplette/assets/images/logo/logo-icon.png" alt=""></a>
                    <div class="back-btn"><i class="fa fa-angle-left"> </i></div>
                </div>
                <div class="logo-icon-wrapper"><a asp-controller="Home" asp-action="Index"><img class="img-fluid" src="~/AccountTemplette/assets/images/logo/logo-icon.png" alt=""></a></div>
                <nav class="sidebar-main">
                    <div class="left-arrow disabled" id="left-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-left"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg></div>
                    <div id="sidebar-menu">
                        <ul class="sidebar-links" id="simple-bar" data-simplebar="init" style="display: block;">
                            <div class="simplebar-wrapper" style="margin: 0px;"><div class="simplebar-height-auto-observer-wrapper"><div class="simplebar-height-auto-observer"></div></div><div class="simplebar-mask"><div class="simplebar-offset" style="right: 0px; bottom: 0px;"><div class="simplebar-content-wrapper" style="height: 100%; overflow: hidden scroll;"><div class="simplebar-content" style="padding: 0px;">
                            <li class="back-btn">
                                <a asp-controller="Home" asp-action="Index" class="active"><img class="img-fluid" src="~/AccountTemplette/assets/images/logo/logo-icon.png" alt=""></a>
                                <div class="mobile-back text-end"> <span>Back </span><i class="fa fa-angle-right ps-2" aria-hidden="true"></i></div>
                            </li>
                            <br />
                            <li class="sidebar-main-title">

                            </li>


                            <li class="sidebar-list">
                                <i class="fa fa-thumb-tack"> </i><a class="sidebar-link sidebar-title active" href="#">
                                    <svg class="stroke-icon">
                                        <use href="AccountTemplette/assets/svg/icon-sprite.svg#stroke-home"></use>
                                    </svg>
                                    <svg class="fill-icon">
                                        <use href="AccountTemplette/assets/svg/icon-sprite.svg#fill-home"></use>
                                    </svg><span>صاحب المشروع</span><div class="according-menu"><i class="fa fa-angle-down"></i></div>
                                </a>
                                <ul class="sidebar-submenu" style="display: block;">
                                    <li><a asp-controller="EspacePromoteur" asp-action="Index" class="active">البيانات الشخصية</a></li>
                                    <li><a asp-controller="EspacePromoteur" asp-action="SuiviDossier">تتبع طلبك</a></li>

                                </ul>
                            </li>
                            <li class="sidebar-list">
                                <i class="fa fa-thumb-tack"></i><a class="sidebar-link sidebar-title" href="#">
                                    <svg class="stroke-icon">
                                        <use href="AccountTemplette/assets/svg/icon-sprite.svg#stroke-widget"></use>
                                    </svg>
                                    <svg class="fill-icon">
                                        <use href="AccountTemplette/assets/svg/icon-sprite.svg#fill-widget"></use>
                                    </svg><span>الإعددات</span><div class="according-menu"><i class="fa fa-angle-right"></i></div>
                                </a>
                                <ul class="sidebar-submenu" style="display: none;">
                                    <li><a asp-area="Identity" asp-page="/Account/Manage/Index">حسابك</a></li>
                                    <li><a href="chart-widget.html">تسجيل الخروج</a></li>
                                </ul>
                            </li>

                    </div>
            </div>
        </div>
    </div><div class="simplebar-placeholder" style="width: auto; height: 2173px;"></div></div><div class="simplebar-track simplebar-horizontal" style="visibility: hidden;"><div class="simplebar-scrollbar simplebar-visible" style="width: 0px; display: none;"></div></div><div class="simplebar-track simplebar-vertical" style="visibility: visible;"><div class="simplebar-scrollbar" style="height: 68px; transform: translate3d(0px, 0px, 0px); display: block;"></div></div></ul>
    <div class="right-arrow" id="right-arrow"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="feather feather-arrow-right"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg></div>
    </div>
    </nav>
    </div>
    <!-- Page Sidebar Ends-->
    <div class="page-body">
        @RenderBody()
    </div>
    <!-- footer start-->
    <footer class="footer">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12 footer-copyright text-center">
                    <p class="mb-0">
                        NESDA |2025
                        الوكالة الوطنية لدعم وتنمية
                        المقاولاتية
                    </p>
                </div>
            </div>
        </div>
    </footer>
    </div>
    </div>


    <!-- latest jquery-->
    <script src="~/AccountTemplette/assets/js/jquery.min.js"></script>
    <!-- Bootstrap js-->
    <script src="~/AccountTemplette/assets/js/bootstrap/bootstrap.bundle.min.js"></script>
    <!-- feather icon js-->
    <script src="~/AccountTemplette/assets/js/icons/feather-icon/feather.min.js"></script>
    <script src="~/AccountTemplette/assets/js/icons/feather-icon/feather-icon.js"></script>
    <!-- scrollbar js-->
    <script src="~/AccountTemplette/assets/js/scrollbar/simplebar.js"></script>
    <script src="~/AccountTemplette/assets/js/scrollbar/custom.js"></script>
    <!-- Sidebar jquery-->
    <script src="~/AccountTemplette/assets/js/config.js"></script>
    <!-- Plugins JS start-->
    <script src="~/AccountTemplette/assets/js/sidebar-menu.js"></script>
    <script src="~/AccountTemplette/assets/js/sidebar-pin.js"></script>
    <script src="~/AccountTemplette/assets/js/slick/slick.min.js"></script>
    <script src="~/AccountTemplette/assets/js/slick/slick.js"></script>
    <script src="~/AccountTemplette/assets/js/header-slick.js"></script>
    <!-- calendar js-->
    <script src="~/AccountTemplette/assets/js/timeline/timeline-v-1/main.js"></script>
    <script src="~/AccountTemplette/assets/js/height-equal.js"></script>
    <script src="~/AccountTemplette/assets/js/modernizr.js"></script>
    <!-- Plugins JS Ends-->
    <!-- Theme js-->
    <script src="~/AccountTemplette/assets/js/script.js"></script>
    @*<script src="~/AccountTemplette/assets/js/theme-customizer/customizer.js"></script>*@

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
